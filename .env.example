# Gmail SMTP Configuration
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_USERNAME=your-email@gmail.com
GMAIL_PASSWORD=your-app-password
GMAIL_FROM_EMAIL=your-email@gmail.com

# Rating Page URL (replace with your deployed index.html URL)
RATING_PAGE_URL=https://example.com/index.html

# Google Apps Script Webhook URL (for feedback submissions)
# Optional: Can be provided here OR as a query parameter in the rating page URL
# If provided here, it will be automatically appended to the rating page URL in emails
WEBHOOK_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID/userweb

# Notes:
# 1. For Gmail, you'll need to use an App Password if you have 2FA enabled
#    See: https://support.google.com/accounts/answer/185833
# 2. The RATING_PAGE_URL should point to where you host the index.html file
# 3. WEBHOOK_URL is optional. Webhook can be configured in three ways:
#    a) Set WEBHOOK_URL in .env (recommended for automated emails)
#    b) Add as query parameter: https://example.com/index.html?webhook=YOUR_URL
#    c) Replace WEBHOOK_URL_PLACEHOLDER in index.html directly
